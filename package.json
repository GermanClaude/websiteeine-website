{
  "name": "scpsl-trust-network",
  "private": true,
  "version": "1.0.0",
  "description": "SCP:SL global anti-cheat, reporting, evidence and trust platform (Centralized Transparency, Decentralized Enforcement)",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./shared --filter ./backend --filter ./web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "dev:backend": "pnpm --filter @scpsl-trust/backend dev",
    "dev:web": "pnpm --filter @scpsl-trust/web dev",
    "migrate": "pnpm --filter @scpsl-trust/backend migrate"
  }
}
