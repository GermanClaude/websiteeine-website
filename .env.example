# SCP:SL Trust Network — environment configuration
#
# Copy to `.env` in the repository root. The backend reads it in development
# (`pnpm dev`, `pnpm migrate`, the CLIs via `tsx --env-file-if-exists=../.env`); in production
# set real environment variables (systemd `Environment=`, Docker `env_file`, secret manager).
# Every variable is documented in docs/CONFIGURATION.md. Values shown here are safe local
# development defaults; NEVER use them in production.
#
# Empty values count as "unset" (the default applies). Booleans accept true/false/1/0/yes/no/on/off.
# Relative paths are resolved against the backend's working directory (backend/.data is git-ignored).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production | test. Production refuses missing or weak secrets.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public URL of the API (links in e-mails, OpenAPI `servers`). Required in production.
PUBLIC_BASE_URL=http://localhost:3000
# Origin of the web panel: the only origin allowed by CORS and the CSRF Origin check.
# Required in production (scheme://host[:port], no path).
WEB_ORIGIN=http://localhost:5173
# Reverse proxy trust for client IPs (rate limits, network hashes): false | true | <hop count> |
# comma-separated IPs/CIDRs (e.g. 10.0.0.0/8,127.0.0.1). Only enable behind a proxy you control.
TRUST_PROXY=false
# Milliseconds to wait for in-flight requests and jobs on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://scpsl:scpsl@localhost:5432/scpsl_trust
DATABASE_POOL_MAX=10
# Statement timeout for the application pool (0 = none).
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply pending migrations at startup (otherwise run `pnpm migrate`).
AUTO_MIGRATE=false
# Optional: directory with the SQL migrations (default: <backend package>/migrations).
#MIGRATIONS_DIR=

# ---------------------------------------------------------------------------
# Redis (nonces, request ids, rate limits, locks, short-lived tokens, VPN cache)
# ---------------------------------------------------------------------------
# Required in production. When unset in development the backend uses in-memory stores
# (single process only; state is lost on restart).
REDIS_URL=redis://localhost:6379
# Prefix of every Redis key (run several deployments on one Redis).
REDIS_KEY_PREFIX=stn:

# ---------------------------------------------------------------------------
# Secrets — generate each one separately: `openssl rand -base64 32`
# ---------------------------------------------------------------------------
# All four are REQUIRED in production and must be distinct, ≥ 32 random bytes.
# Development: leave empty to get ephemeral random values (with a loud warning on startup;
# sessions, encrypted 2FA secrets and network-hash correlation do not survive a restart).
# Signs short-lived evidence download tickets.
JWT_SECRET=
# Signs the session cookie and derives CSRF tokens. Changing it logs every user out.
SESSION_SECRET=
# AES-256-GCM key for secrets at rest (TOTP secrets, Overwatch session secrets):
# base64 of exactly 32 bytes. Losing it makes every stored secret unreadable.
DATA_ENCRYPTION_KEY=
# HMAC key of the network hashes (§8.1). Rotating it breaks alt-account correlation
# with older observations (documented, intended).
IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# Web sessions & authentication
# ---------------------------------------------------------------------------
# Send the session cookie with the Secure flag (requires HTTPS). Default true; false for
# plain-HTTP local development only.
COOKIE_SECURE=false
# Absolute session lifetime (hours) and idle timeout (minutes).
SESSION_TTL_HOURS=168
SESSION_IDLE_TIMEOUT_MINUTES=720
# Users must verify their e-mail before logging in.
EMAIL_VERIFICATION_REQUIRED=true
# Allow self-registration through POST /auth/register.
ALLOW_REGISTRATION=true
# Roles that must enroll 2FA (comma-separated UserRole values, or `none`).
REQUIRE_2FA_ROLES=reviewer,moderator,admin,super_admin
# Failed logins before an account is temporarily locked (15 min × 2^(n−LOGIN_MAX_FAILURES), max 24 h).
LOGIN_MAX_FAILURES=5

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# smtp | file | noop. Default: smtp in production, file in development, noop in test.
# `file` writes .eml/.json files into MAIL_FILE_DIR and is refused in production.
MAIL_TRANSPORT=file
MAIL_FROM="SCP:SL Trust Network <no-reply@localhost>"
# Required when MAIL_TRANSPORT=smtp, e.g. smtps://user:password@mail.example.org:465
#SMTP_URL=
MAIL_FILE_DIR=./.data/mail

# ---------------------------------------------------------------------------
# Evidence storage
# ---------------------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/evidence
# s3 driver (AWS S3, MinIO, Ceph, R2, …). STORAGE_BUCKET is required for s3; the access key
# pair is optional (the AWS SDK default credential chain is used when both are unset).
#STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
#STORAGE_BUCKET=scpsl-trust-evidence
#STORAGE_ACCESS_KEY=
#STORAGE_SECRET_KEY=
# Path-style bucket addressing (MinIO and most self-hosted S3 implementations need true).
STORAGE_FORCE_PATH_STYLE=false
# Maximum evidence upload size in bytes (default 500 MiB).
EVIDENCE_MAX_BYTES=524288000
# Upload quotas (§11.3). Non-staff = uploaders without evidence:upload (reporters, server teams).
EVIDENCE_MAX_BYTES_NON_STAFF=209715200
EVIDENCE_UPLOADS_PER_HOUR=60
EVIDENCE_UPLOADS_PER_HOUR_NON_STAFF=10
EVIDENCE_DAILY_BYTES_NON_STAFF=1073741824

# ---------------------------------------------------------------------------
# SCP:SL server (plugin) authentication
# ---------------------------------------------------------------------------
# Accepted clock skew of signed requests (§5.4 step 2).
SIGNATURE_MAX_SKEW_SECONDS=60
# How long the previous key stays valid after a rotation (§5.5).
KEY_ROTATION_GRACE_SECONDS=600
# Validity of registration tokens shown in the web panel (§5.2).
REGISTRATION_TOKEN_TTL_HOURS=24

# ---------------------------------------------------------------------------
# VPN detection (§6.4) — a VPN is never cheating
# ---------------------------------------------------------------------------
# Comma-separated providers: noop | cidr-list | proxycheck | iphub (result = highest confidence).
VPN_PROVIDERS=noop
# Required for cidr-list: comma-separated files with one CIDR per line.
#VPN_CIDR_LIST_PATHS=./.data/vpn/hosting.txt
# Confidence reported for a CIDR match: possible | likely | confirmed.
VPN_CIDR_CONFIDENCE=likely
#PROXYCHECK_API_KEY=
# Required for the iphub provider.
#IPHUB_API_KEY=
VPN_PROVIDER_TIMEOUT_MS=1500
# Result cache per network hash in Redis (seconds).
VPN_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Account age (§6.3) and alt-account analysis (§8.2)
# ---------------------------------------------------------------------------
# Steam Web API key for account creation dates; unset = unknown / server-reported only.
#STEAM_WEB_API_KEY=
ACCOUNT_AGE_CACHE_DAYS=7
ALT_LOOKBACK_DAYS=30
ALT_MAX_SHARED_ACCOUNTS=4

# ---------------------------------------------------------------------------
# Overwatch proof (§10), whitelist requests (§11.6)
# ---------------------------------------------------------------------------
# Proof-code interval (5–60 s) and heartbeat timeout after which a session expires.
OVERWATCH_INTERVAL_SECONDS=10
OVERWATCH_HEARTBEAT_TIMEOUT_SECONDS=90
# Proof API requests per minute per user/IP.
PROOF_RATE_LIMIT_PER_MINUTE=20
# Pending whitelist requests expire after this many days.
WHITELIST_REQUEST_TTL_DAYS=14

# ---------------------------------------------------------------------------
# Retention (§8.3; case history, evidence metadata and audit events are never deleted)
# ---------------------------------------------------------------------------
RETENTION_NETWORK_OBSERVATIONS_DAYS=30
RETENTION_PLAYER_SIGNALS_DAYS=90
RETENTION_SESSIONS_DAYS=30
RETENTION_OVERWATCH_SECRETS_DAYS=365

# ---------------------------------------------------------------------------
# Features, jobs, logging
# ---------------------------------------------------------------------------
# Run background jobs (retention, expiries) in this process. Set false on extra API replicas.
JOBS_ENABLED=true
# Anonymous GET /public/cases/{caseNumber}.
PUBLIC_CASE_LOOKUP=true
# Swagger UI at /api/docs (the OpenAPI JSON is always served). Default: on outside production.
OPENAPI_UI=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Log the client's network hash (never the raw IP) with each request.
LOG_CLIENT_IP=false
# Human-readable log output (pino-pretty) for local development.
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Rate limits (§14)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Web requests per client IP and minute.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Signed plugin requests per server and minute.
RATE_LIMIT_PLUGIN_PER_MINUTE=600
# Login/registration/reset/2FA requests per IP and minute.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Report creation per user and hour.
RATE_LIMIT_REPORTS_PER_HOUR=10
# Failed signed-request authentications per (server, client) and minute before 429.
RATE_LIMIT_SERVER_AUTH_FAILURES_PER_MINUTE=30

# ---------------------------------------------------------------------------
# Security: intrusion detection & anomaly flagging (server-side only; §8, §14)
# ---------------------------------------------------------------------------
# Master switch for the request observer, scoring and transient auto-blocking. When off, the
# observer is not registered at all. Fails open: if the short-lived store (Redis) is down,
# detection degrades to off and legitimate traffic is never blocked because of it.
SECURITY_DETECTION_ENABLED=true
# Decaying risk score at which a source is auto-blocked within the window.
SECURITY_BLOCK_THRESHOLD=100
# Scoring/decay window in seconds.
SECURITY_WINDOW_SECONDS=300
# Base transient-block duration in seconds; doubled on each repeat offence (exponential backoff, capped at 7 days).
SECURITY_BLOCK_TTL_SECONDS=900
# Requests per source and minute above which a burst signal is emitted.
SECURITY_BURST_PER_MINUTE=300
# Heuristic anomaly flagging (review items only; never blocks or punishes).
SECURITY_ANOMALY_ENABLED=true
# Robust z-score / EWMA deviation threshold for anomaly flagging (higher = quieter).
SECURITY_ANOMALY_SENSITIVITY=3.5

# ---------------------------------------------------------------------------
# Command-line tools and tests
# ---------------------------------------------------------------------------
# Password for `pnpm --filter @scpsl-trust/backend cli:create-admin` (else an interactive prompt).
#ADMIN_PASSWORD=
# Admin connection used by the backend test suite to create throw-away databases (needs CREATEDB;
# reset() needs superuser). Default: postgres://scpsl:scpsl@localhost:5432/postgres
#TEST_DATABASE_ADMIN_URL=
# Redis used by tests that opt into a real Redis (random key prefix per test app).
#REDIS_TEST_URL=redis://localhost:6379/15

# ---------------------------------------------------------------------------
# Web panel (Vite build-time variables; see web/.env.example)
# ---------------------------------------------------------------------------
# Dev-server proxy target for /api.
VITE_API_PROXY_TARGET=http://localhost:3000
# Hide the registration link in the UI (the backend's ALLOW_REGISTRATION still decides).
VITE_REGISTRATION_ENABLED=true
