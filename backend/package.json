{
  "name": "@scpsl-trust/backend",
  "version": "1.0.0",
  "private": true,
  "description": "SCP:SL Trust Network backend API (Fastify, PostgreSQL, Redis)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../.env src/cli/migrate.ts",
    "cli:create-admin": "tsx --env-file-if-exists=../.env src/cli/create-admin.ts",
    "cli:verify-audit": "tsx --env-file-if-exists=../.env src/cli/verify-audit.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/lib-storage": "^3.1142.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@scpsl-trust/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.12",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
