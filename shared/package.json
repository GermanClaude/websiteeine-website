{
  "name": "@scpsl-trust/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, enums, zod schemas, permissions, signing canonicalization and policy engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./test-vectors/*": "./test-vectors/*"
  },
  "files": [
    "dist",
    "test-vectors"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "vectors": "tsx scripts/generate-test-vectors.ts",
    "vectors:check": "tsx scripts/generate-test-vectors.ts --check"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
