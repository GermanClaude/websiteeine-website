<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScpslTrust.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <!-- Same major version as the YamlDotNet shipped with the game; used to prove the config is LabAPI-YAML friendly. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ScpslTrust.Core/ScpslTrust.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cross-language fixtures generated by the shared package. -->
    <None Include="../../../shared/test-vectors/*.json" LinkBase="test-vectors" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
